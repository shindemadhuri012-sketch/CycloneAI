# CycloneAI .gitignore

# Environment Variables
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
venv/
ENV/
env/

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
frontend/dist/
frontend/dist-ssr/
*.local

# Datasets (Large Files) - Preserving directory READMEs and verified production data
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/README.md
!data/processed/tracks_processed.csv
data/external/*
!data/external/README.md
data/sample/*
!data/sample/README.md

# Machine Learning Models and Weights - Whitelisting verified production checkpoints
*.pt
*.pth
*.onnx
*.h5
*.pkl
*.ckpt
!ml/models/saved/*.joblib
!ml/models/saved/*.json



# IDE and OS Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
