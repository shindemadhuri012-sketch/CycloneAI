# CycloneAI Backend Production Environment Variables
# Copy to .env and adjust as necessary for deployment

PROJECT_NAME="CycloneAI Backend"
PROJECT_TITLE="Intelligent Tropical Cyclone Analysis & Prediction System"
API_V1_STR="/api"
HOST="0.0.0.0"
PORT=8000
ENVIRONMENT="production"
VERSION="1.0.0"

# Static SPA Serving (Set to False if running frontend independently via Vite/Nginx)
SERVE_STATIC_SPA=True

# CORS Configuration (Comma-separated or JSON list)
# CORS_ORIGINS=["http://localhost:5173", "http://localhost:8000", "*"]
